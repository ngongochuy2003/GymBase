{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "GymBase.Poc.Media": "Debug"
    }
  },
  "GymBase": {
    "Media": {
      "BucketName": "gymbase-media",
      "ServiceUrl": "http://localhost:9000",
      "ForcePathStyle": true,
      "UseInMemoryStorage": false,
      "AllowAnonymousForPoc": true
    }
  }
}
