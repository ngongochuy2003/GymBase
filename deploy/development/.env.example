# MÔI TRƯỜNG DEV. Copy thành .env trong thư mục này (không commit). Production có file riêng ở deploy/production.
# Giá trị ở đây chỉ để thử, đừng dùng lại mật khẩu hay khóa của production.

# MySQL trong Docker (chỉ chữ và số, vì mật khẩu được ghép vào connection string).
MYSQL_DATABASE=gymbase
MYSQL_USER=gymbase
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Cổng MySQL mở cho máy này (mặc định 3307 để không đụng MySQL cài sẵn ở 3306).
MYSQL_PORT=3307

# Cổng API trên máy này (mặc định 5020, khớp EXPO_PUBLIC_API_URL của mobile). Đổi nếu API chạy tay đang giữ cổng đó.
API_PORT=5020

# Base64 của ít nhất 32 byte ngẫu nhiên:  openssl rand -base64 48
Jwt__SigningKey=
