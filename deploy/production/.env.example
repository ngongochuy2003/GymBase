# Copy thành .env trong thư mục này rồi điền. File .env KHÔNG commit, đặt quyền chặt: chmod 600 .env

# --- Tên miền và chứng chỉ HTTPS (Let's Encrypt) ---
# Tên miền đã trỏ A/AAAA về IP máy chủ; cổng 80 và 443 mở.
API_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=
# Đặt 1 khi chạy thử init-letsencrypt.sh để khỏi chạm giới hạn của Let's Encrypt; xóa hoặc 0 khi chạy thật.
LETSENCRYPT_STAGING=0

# --- Image do CI đẩy lên registry (workflow api-image.yml) ---
# Image đầy đủ là ${IMAGE_PREFIX}-api:${IMAGE_TAG} và ${IMAGE_PREFIX}-migrator:${IMAGE_TAG}.
IMAGE_PREFIX=ghcr.io/ngongochuy2003/gymbase
# Ghim một tag cụ thể (sha-xxxxxxx hoặc v1.2.3), không dùng latest. scripts/deploy.sh tự cập nhật dòng này.
IMAGE_TAG=

# --- MySQL (chỉ chữ và số, vì mật khẩu được ghép vào connection string) ---
MYSQL_DATABASE=gymbase
MYSQL_USER=gymbase
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- API ---
# Base64 của ít nhất 32 byte ngẫu nhiên, mỗi môi trường một khóa:  openssl rand -base64 48
Jwt__SigningKey=
# Origin được gọi API từ trình duyệt (để trống nếu chỉ có app mobile). Không dùng *.
CORS_ORIGIN_0=
# Web client ID của Google Cloud (cũng là aud mà API kiểm tra). Để trống thì /auth/google trả 401.
GOOGLE_WEB_CLIENT_ID=
# true: thông báo đẩy chỉ giả lập, chưa gửi thật (mặc định của appsettings).
NOTIFICATION_SIMULATE_MODE=true

# --- Lưu file: S3 hoặc dịch vụ tương thích S3 ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Để trống với AWS S3; điền endpoint với dịch vụ khác (Cloudflare R2, Wasabi, MinIO...).
S3_SERVICE_URL=
# true với MinIO và một số dịch vụ tương thích S3; false với AWS S3.
S3_FORCE_PATH_STYLE=false

# --- Sao lưu ---
# Số ngày giữ file sao lưu trong deploy/production/backups.
BACKUP_KEEP_DAYS=14
