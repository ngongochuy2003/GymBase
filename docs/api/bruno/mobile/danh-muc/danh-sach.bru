meta {
  name: Danh sách theo loại
  type: http
  seq: 1
}

get {
  url: {{mobileApi}}/danh-muc?ma_dinh_danh=muc_tieu_tap_luyen,khu_vuc,chuyen_mon_pt
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

params:query {
  ma_dinh_danh: muc_tieu_tap_luyen,khu_vuc,chuyen_mon_pt
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Trả các mục đang dùng (tinh_trang = 1), nhóm theo ma_dinh_danh.
  Bỏ tham số thì trả mọi loại đang có mục dùng được.
  Lấy accessToken bằng request đăng nhập trong thư mục Xác thực.
}
