meta {
  name: Người dùng - phân trang
  type: http
  seq: 3
}

get {
  url: {{mobileApi}}/users?page=2&page_size=2
  body: none
  auth: bearer
}

params:query {
  page: 2
  page_size: 2
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}
