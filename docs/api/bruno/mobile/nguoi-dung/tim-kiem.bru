meta {
  name: Tìm kiếm
  type: http
  seq: 4
}

get {
  url: {{mobileApi}}/users?search=pt
  body: none
  auth: bearer
}

params:query {
  search: pt
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Tìm theo tên đăng nhập, họ tên, email, số điện thoại.
}
