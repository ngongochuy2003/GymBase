meta {
  name: Lưu thiết lập
  type: http
  seq: 2
}

put {
  url: {{mobileApi}}/ho-so
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "loai_nguoi_dung": "hoc_vien",
    "muc_tieu_tap_luyen": "tang_co",
    "chieu_cao_cm": 172.5,
    "can_nang_kg": 68.4,
    "khu_vuc_hoat_dong": "ha_noi"
  }
}

assert {
  res.status: eq 200
  res.body.loai_nguoi_dung: eq hoc_vien
}

docs {
  Mã mục tiêu/khu vực lấy từ GET /danh-muc. Lưu lại cùng số đo không thêm dòng chi_so_co_the; đổi chiều cao hoặc cân nặng thì thêm một dòng.
}
