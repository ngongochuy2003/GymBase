meta {
  name: Xem hồ sơ
  type: http
  seq: 1
}

get {
  url: {{mobileApi}}/ho-so
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  Trả hồ sơ hiện tại + chi_so_co_the mới nhất.
  Chưa thiết lập hồ sơ thì 404 PROFILE_NOT_FOUND — chạy request "Lưu thiết lập" trước.
}
