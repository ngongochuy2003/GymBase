meta {
  name: Người dùng - xóa
  type: http
  seq: 10
}

delete {
  url: {{mobileApi}}/users/{{createdUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 204
}

docs {
  Xóa mềm. Gọi lại lần nữa sẽ nhận 404.
}
