meta {
  name: Đăng nhập
  type: http
  seq: 1
}

post {
  url: {{mobileApi}}/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "tai_khoan": "{{adminUserName}}",
    "mat_khau": "{{adminPassword}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("accessToken", res.body.access_token);
  bru.setVar("refreshToken", res.body.refresh_token);
  bru.setVar("adminId", res.body.user.id);
}

docs {
  Chạy request này trước. Các request khác dùng biến accessToken. Tài khoản Admin tạo bằng lệnh create-admin, mật khẩu đặt ở biến bí mật adminPassword của environment.
}
