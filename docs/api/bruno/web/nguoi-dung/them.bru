meta {
  name: Thêm
  type: http
  seq: 9
}

post {
  url: {{webApi}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "ten_dang_nhap": "{{newUserName}}",
    "mat_khau": "Mk-thu-nghiem-1",
    "ho_ten": "Học viên mới",
    "email": "{{newEmail}}",
    "so_dien_thoai": "0900000099",
    "vai_tro": "User"
  }
}

script:pre-request {
  // Tên đăng nhập và email mới mỗi lần gửi, vì gửi lại sẽ bị 409 USER_USERNAME_TAKEN hoặc USER_EMAIL_TAKEN.
  const suffix = Date.now();
  bru.setVar("newUserName", "hv.moi." + suffix);
  bru.setVar("newEmail", "hv.moi." + suffix + "@gymbase.local");
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("createdUserId", res.body.id);
}

docs {
  Tên đăng nhập sinh mới mỗi lần gửi. Lưu Id vừa tạo vào biến createdUserId để các request sửa/xóa dùng.
}
