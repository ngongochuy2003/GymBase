meta {
  name: Đã xóa (404)
  type: http
  seq: 16
}

get {
  url: {{webApi}}/users/{{createdUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 404
  res.body.code: eq NOT_FOUND
}

docs {
  Chạy "Thêm" rồi "Xóa" trước. Bản ghi đã xóa không còn đọc được.
}
