meta {
  name: Xóa
  type: http
  seq: 15
}

delete {
  url: {{webApi}}/users/{{createdUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 204
}

docs {
  Xóa hẳn. Gọi lại lần nữa sẽ nhận 404. Người dùng đang được dùng ở bảng khác thì nhận 409 `IN_USE`.
}
