meta {
  name: Người dùng - thêm
  type: http
  seq: 7
}

post {
  url: {{webApi}}/users
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "tai_khoan": "{{newUserName}}",
    "ho_ten": "Học viên mới",
    "email": "moi@gymbase.local",
    "so_dien_thoai": "0900000099",
    "vai_tro": "Trainee"
  }
}

script:pre-request {
  // Tên đăng nhập mới mỗi lần gửi, vì gửi lại cùng tên sẽ bị 409 USER_USERNAME_TAKEN.
  bru.setVar("newUserName", "hv.moi." + Date.now());
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("createdUserId", res.body.id);
}

docs {
  Tên đăng nhập sinh mới mỗi lần gửi. Lưu Id vừa tạo vào biến createdUserId để các request sửa/xóa dùng. Dữ liệu mock mất khi tắt host.
}
