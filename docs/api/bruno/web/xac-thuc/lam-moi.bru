meta {
  name: Làm mới token
  type: http
  seq: 5
}

post {
  url: {{webApi}}/auth/refresh
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "refresh_token": "{{refreshToken}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("accessToken", res.body.access_token);
  bru.setVar("refreshToken", res.body.refresh_token);
}
