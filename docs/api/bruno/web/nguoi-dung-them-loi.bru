meta {
  name: Người dùng - thêm thiếu dữ liệu (400)
  type: http
  seq: 8
}

post {
  url: {{webApi}}/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

body:json {
  {
    "tai_khoan": "x",
    "email": "khong-phai-email",
    "vai_tro": "Trainee"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_FAILED
}

docs {
  Thiếu ho_ten, tai_khoan quá ngắn, email sai định dạng.
}
