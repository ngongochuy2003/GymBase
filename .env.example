# Copy to .env ở gốc repo. Docker compose đọc file này (infrastructure/docker/compose.dev.yml):
#   docker compose --env-file .env -f infrastructure/docker/compose.dev.yml up --build -d

# MySQL trong Docker. Mật khẩu có ký tự đặc biệt (; = ") sẽ làm hỏng connection string, nên dùng chữ và số.
MYSQL_DATABASE=gymbase
MYSQL_USER=gymbase
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Cổng MySQL mở cho máy này (mặc định 3307 để không đụng MySQL cài sẵn ở 3306).
MYSQL_PORT=3307

# Cổng API trên máy này (mặc định 5020, khớp EXPO_PUBLIC_API_URL của mobile). Đổi nếu API chạy tay đang giữ cổng đó.
API_PORT=5020
# Mặc định Development (bật OpenAPI).
# ASPNETCORE_ENVIRONMENT=Development

# API: Docker tự ghép connection string từ MYSQL_*; chỉ cần khi chạy API ngoài Docker (hoặc dùng dotnet user-secrets).
ConnectionStrings__DefaultConnection=
# Origins allowed to call the API from a browser, one variable each. Never use *.
Cors__AllowedOrigins__0=
# Base64 of at least 32 random bytes. Use a different key per environment.
# Tạo: openssl rand -base64 48   (PowerShell: xem docs/api/cach-chay-api.md)
Jwt__SigningKey=

# Mobile: copy this PUBLIC variable to apps/mobile/.env after MOBILE-01.
# On a physical device, use the development machine's LAN address.
# Never put credentials or private tokens in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=
