# Reserved configuration names; REPO-01 has no runtime consuming this file.
# Copy to .env locally when DB-01 defines the Docker configuration.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# API: use environment variables or dotnet user-secrets after API-01.
ConnectionStrings__DefaultConnection=

# Mobile: copy this PUBLIC variable to apps/mobile/.env after MOBILE-01.
# On a physical device, use the development machine's LAN address.
# Never put credentials or private tokens in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=
