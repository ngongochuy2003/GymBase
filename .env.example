# Docker has a separate .env per environment, each with its own .env.example:
#   deploy/development/.env.example   MySQL + API on a dev machine
#   deploy/production/.env.example    the real server (nginx, S3, image tag)
# This root file only lists names for running the API outside Docker (dotnet run) and for the mobile app.

# API outside Docker: use environment variables or dotnet user-secrets (docs/api/cach-chay-api.md).
ConnectionStrings__DefaultConnection=
# Origins allowed to call the API from a browser, one variable each. Never use *.
Cors__AllowedOrigins__0=
# Base64 of at least 32 random bytes. Use a different key per environment.
Jwt__SigningKey=

# Mobile: copy this PUBLIC variable to apps/mobile/.env after MOBILE-01.
# On a physical device, use the development machine's LAN address.
# Never put credentials or private tokens in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=
