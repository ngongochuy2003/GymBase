{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gymbase-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {TraceId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Google": {
    "ClientIds": []
  },
  "AuditLog": {
    "RetentionDays": 90
  },
  "Storage": {
    "DefaultProvider": "MINIO",
    "LocalRoot": "uploads",
    "BucketName": "gymbase-files",
    "Region": "us-east-1",
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "ForcePathStyle": true
  },
  "ThongBao": {
    "PushProvider": "LOG",
    "Fcm": {
      "ProjectId": "",
      "CredentialsPath": ""
    },
    "IntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 5,
    "BackoffSeconds": 30,
    "MaxBackoffSeconds": 600,
    "ReclaimMinutes": 5
  },
  "AllowedHosts": "*"
}
