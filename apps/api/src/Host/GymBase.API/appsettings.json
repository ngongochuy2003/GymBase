{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gymbase-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {TraceId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Google": {
    "ClientIds": []
  },
  "AuditLog": {
    "RetentionDays": 90
  },
  "Storage": {
    "DefaultProvider": "LOCAL",
    "LocalRoot": "uploads",
    "BucketName": "gymbase-files",
    "Region": "ap-southeast-1",
    "MaxUploadBytes": 10485760,
    "AllowAnonymousForDev": true
  },
  "Notification": {
    "FirebaseProjectId": "gymbase-dev",
    "SimulateMode": true,
    "DefaultChannelId": "gymbase_urgent_messages"
  },
  "AllowedHosts": "*"
}
