<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Connection string khi dev đặt trong user-secrets, không ghi vào appsettings. -->
  <PropertyGroup>
    <UserSecretsId>gymbase-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Chỉ dùng lúc chạy dotnet ef, không đi vào bản publish. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <!-- Host là composition root: tham chiếu mọi BL, và các DL.*.MySql chỉ để đăng ký dịch vụ. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Base\GymBase.Base.Hosting\GymBase.Base.Hosting.csproj" />
    <ProjectReference Include="..\..\Auth\GymBase.BLAuth\GymBase.BLAuth.csproj" />
    <ProjectReference Include="..\..\DI\GymBase.BLDI\GymBase.BLDI.csproj" />
    <ProjectReference Include="..\..\BIZ\GymBase.BLBiz\GymBase.BLBiz.csproj" />
    <ProjectReference Include="..\..\Auth\GymBase.DLAuth.MySql\GymBase.DLAuth.MySql.csproj" />
    <ProjectReference Include="..\..\DI\GymBase.DLDI.MySql\GymBase.DLDI.MySql.csproj" />
    <ProjectReference Include="..\..\BIZ\GymBase.DLBiz.MySql\GymBase.DLBiz.MySql.csproj" />
  </ItemGroup>

</Project>
