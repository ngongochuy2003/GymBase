# Quy ước riêng của GymBase.Model (xem 1.Doc/crud-dung-chung.md)

[*.cs]
# Namespace chỉ chia theo tầng (GymBase.Model.Entities); thư mục con theo phân hệ chỉ để sắp xếp file.
# Không theo thư mục để tránh namespace GymBase.Model.Entities.System che namespace System của .NET.
dotnet_style_namespace_match_folder = false
dotnet_diagnostic.IDE0130.severity = none

[Entities/**.cs]
# Tên class trùng tên bảng (nguoi_dung), cố ý không theo PascalCase.
dotnet_diagnostic.IDE1006.severity = none
