{
  "expo": {
    "name": "GymBase",
    "slug": "gymbase-mobile",
    "scheme": "gymbase",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#FF231F7C",
          "defaultChannel": "gymbase_urgent_messages"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép GymBase truy cập thư viện ảnh để chọn ảnh và video đăng bài.",
          "cameraPermission": "Cho phép GymBase truy cập máy ảnh để chụp ảnh và quay video đăng bài."
        }
      ]
    ],
    "android": {
      "package": "vn.gymbase.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE"
      ]
    },
    "ios": {
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "GymBase Mobile"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}