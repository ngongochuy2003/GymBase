# Never place secrets in EXPO_PUBLIC_*.
# Nguồn dữ liệu lịch tập: demo (dữ liệu mẫu) cho tới khi có API lịch tập. Đăng nhập luôn gọi API thật.
EXPO_PUBLIC_DATA_MODE=demo
# Địa chỉ backend, bắt buộc. Emulator Android thấy máy chủ dev qua 10.0.2.2; thiết bị thật dùng IP LAN
# hoặc HTTPS. Backend chạy theo docs/api/cach-chay-api.md (mặc định cổng 5020).
EXPO_PUBLIC_API_URL=http://10.0.2.2:5020
# Liên kết Điều khoản sử dụng và Chính sách bảo mật ở màn đăng ký. Để trống thì dùng URL giữ chỗ (TODO LEGAL).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
